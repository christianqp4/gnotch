#!/bin/sh
# GNotch's app launcher (Activities search, the dock, its right-click menu, or `gnotch` in a terminal).
# GNotch lives inside GNOME Shell as an extension, so this just asks it to open a page:
#   gnotch [timer|clipboard|vision|drift]
UUID=gnotch@christianqp4.github.io
page="${1:-timer}"
if [ "$page" = drift ]; then
  set -- --method io.github.christianqp4.GNotch.TogglePause
else
  set -- --method io.github.christianqp4.GNotch.Show "'$page'"
fi
gdbus call --session --dest org.gnome.Shell --object-path /io/github/christianqp4/GNotch "$@" >/dev/null 2>&1 && exit 0

# Not running yet: right after installing, GNOME only loads new extensions at the next login.
gnome-extensions enable "$UUID" >/dev/null 2>&1 || true
notify-send -i gnotch "GNotch is installed" \
  "Log out and back in once to start it. After that it sits next to the clock." 2>/dev/null
exit 1
